+      else if (keys[0] === 'Enter') pane = 'Auto-compact at 80%';
+      else if (keys[0] === 'Tab') pane = pane.includes('Auto-compact') ? 'Session usage: no model calls yet' : `Session ID: ${id}`;
+      else if (keys[0] === 'Escape') pane = '│ ❯  │\nShift+Tab:mode';
