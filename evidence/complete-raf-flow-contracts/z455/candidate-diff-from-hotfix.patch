+    const { result, code } = await running;
+    assert.deepEqual(result.knownRed, [a, sibling], JSON.stringify(result));
+    assert.deepEqual(h.state.get()?.knownRed, [a, sibling]);
+    assert.deepEqual(result.removed, []);
