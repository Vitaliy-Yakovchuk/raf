      "handlerName": "test run",
      "metadata": {
        "path": [
          "test",
          "run"
        ],
        "description": "Запустити адресну unit-групу або integration-сценарій (фаза integration) за політикою фази.",
        "parameters": [
          {
            "name": "project",
            "option": "--project",
            "required": true,
            "multiple": false,
            "description": "Зареєстрований проєкт."
          },
          {
            "name": "phase",
            "option": "--phase",
            "required": true,
            "multiple": false,
            "description": "Фаза прогону."
          },
          {
            "name": "group",
            "option": "--group",
            "required": true,
            "multiple": false,
            "description": "Стабільна група <change>/<group>: unit-група або точний preset integration-сценарію."
          },
          {
            "name": "files",
            "option": "--files",
            "required": false,
            "multiple": true,
            "description": "Точні відносні файли групи одним списком після одного --files (прапорець не повторювати)."
          },
          {
            "name": "only",
            "option": "--only",
            "required": false,
            "multiple": true,
            "description": "Лише knownRed IDs у форматі file::name; для integration-профілю не дозволено."
          }
        ],
        "valueSources": {
          "project": "projects.json#/projects",
          "phase": "raf-constants.json#/agentPhases"
        },
        "output": "JSON TestRunResult з testKind, timeoutPolicy і callerPhase; код 0 лише для passed.",
        "errors": "Ненульовий код для refused, setup-failed, assertions-failed, timed-out, interrupted та unverified-remainder.",
        "prerequisites": "Активна зміна, налаштований профіль, перевірене робоче дерево та ізольований QA HOME для raf-develop/hotfix.",
        "sideEffects": "Адресний процес unit- або integration-тестів, його дерево та активний агрегат SQLite вибраного HOME; без історії прогонів.",
        "examples": [
          "raf test run --project etchly --phase main --group complete-raf-flow-contracts/catalog-generator"
        ],
        "errorCodes": [
          "UNKNOWN_COMMAND",
          "UNKNOWN_ARGUMENT",
          "DUPLICATE_ARGUMENT",
          "MISSING_VALUE",
          "MISSING_REQUIRED",
          "INVALID_VALUE",
          "HANDLER_FAILED",
          "HANDLER_UNAVAILABLE",
          "COMMAND_UNAVAILABLE",
          "CATALOG_UNAVAILABLE",
