+  assert.deepEqual(harness.state.get()?.knownRed, []);
+  assert.deepEqual(harness.state.get()?.unexecuted, []);
+  assert.deepEqual(harness.state.get()?.lastResult?.removed, [removedBeta, beta]);
+});
