{
  "program": "raf",
  "commands": [
    {
      "path": [
        "service",
        "start"
      ],
      "description": "Запустити службу raf із робочого main і перевірити готовність.",
      "parameters": [],
      "output": "JSON фактичного стану служби; exit 0 лише після перевіреної готовності.",
      "errors": "Ненульовий код із errorCodes та JSON code/message/details/remediation. За часткового виконання перевірте completed/pending і retrySafe перед повтором; довідка: raf help service start.",
      "prerequisites": "Зареєстроване дерево raf main, валідний state context і налаштований service host.",
      "sideEffects": "Ідемпотентно запускає одну фонову службу через singleton ownership/readiness; агентів не перезапускає.",
      "examples": [
        "raf service start"
      ],
      "errorCodes": [
        {
          "id": "UNKNOWN_COMMAND",
          "description": "Невідомий шлях команди або довідки.",
          "exitCode": 1
        },
        {
          "id": "UNKNOWN_ARGUMENT",
          "description": "Невідомий аргумент або зайве позиційне значення.",
          "exitCode": 1
        },
        {
          "id": "DUPLICATE_ARGUMENT",
          "description": "Одиничний параметр передано повторно.",
          "exitCode": 1
        },
        {
          "id": "MISSING_VALUE",
          "description": "Параметр потребує непорожнього значення.",
          "exitCode": 1
        },
        {
          "id": "MISSING_REQUIRED",
          "description": "Не задано обов’язковий параметр.",
          "exitCode": 1
        },
        {
          "id": "INVALID_VALUE",
          "description": "Значення або комбінація параметрів не підтримуються.",
          "exitCode": 1
        },
        {
          "id": "HANDLER_FAILED",
          "description": "Обробник завершився помилкою; причина невідома.",
          "exitCode": 1
        },
        {
          "id": "HANDLER_UNAVAILABLE",
          "description": "Обробник команди недоступний.",
          "exitCode": 1
        },
        {
          "id": "COMMAND_UNAVAILABLE",
          "description": "Команда недоступна в обраному поколінні raf.",
          "exitCode": 1
        },
        {
          "id": "CATALOG_UNAVAILABLE",
          "description": "Скомпільований каталог відсутній або пошкоджений.",
          "exitCode": 1
        },
        {
          "id": "CONFIGURATION_INVALID",
          "description": "Конфігурація відсутня або не відповідає контракту.",
          "exitCode": 1
        },
        {
          "id": "PRODUCTION_ENTRY_FAILED",
          "description": "Не вдалося завершити production-операцію raf.",
          "exitCode": 1
        },
        {
          "id": "STATE_CONTEXT_REFUSED",
          "description": "Не доведено право цього покоління на контекст стану.",
          "exitCode": 1
        },
        {
          "id": "TIMING_FAILED",
          "description": "timing failed",
          "exitCode": 1
        },
        {
          "id": "SERVICE_OPERATION_FAILED",
          "description": "service operation failed",
          "exitCode": 1
        }
      ],
      "handlerName": "service start",
      "valueSources": {},
      "metadata": {
        "path": [
          "service",
          "start"
        ],
        "description": "Запустити службу raf із робочого main і перевірити готовність.",
        "parameters": [],
        "output": "JSON фактичного стану служби; exit 0 лише після перевіреної готовності.",
        "errors": "Ненульовий код із errorCodes та JSON code/message/details/remediation. За часткового виконання перевірте completed/pending і retrySafe перед повтором; довідка: raf help service start.",
        "prerequisites": "Зареєстроване дерево raf main, валідний state context і налаштований service host.",
        "sideEffects": "Ідемпотентно запускає одну фонову службу через singleton ownership/readiness; агентів не перезапускає.",
        "examples": [
          "raf service start"
        ],
        "errorCodes": [
          "UNKNOWN_COMMAND",
          "UNKNOWN_ARGUMENT",
          "DUPLICATE_ARGUMENT",
          "MISSING_VALUE",
