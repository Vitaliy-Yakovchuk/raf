+export async function verifyNativeDocumentClose(close: any, session: any, ports: any) {
+  assert.equal(close.exitCode, 0, JSON.stringify(close));
+  await ports.wait(async () => !await ports.alive(session.process.pid), Boolean, 'Verified native exit');
+  const after = ports.inspect();
+  assert.deepEqual(after.claims, []);
+  assert.deepEqual(after.admission, []);
+  assert.equal(after.pending.filter((p: any) => p.runId === session.runId).length, 0);
+  return after;
+}
