+  { name: 'quoted modal in a draft', screen: '› Explain Approaching rate limits · Switch to gpt-6-luna for lower credit usage? 2. Keep current model', owned: true },
+]) {
+  test(`running codex leaves ${scenario.name} untouched`, async t => {
+    const f = await fixture(t, scenario.screen, scenario.owned, 'codex');
+    assert.equal((await f.services.control.ps()).length, 1);
+    assert.equal(f.calls.some(args => args.includes('send-keys')), false);
+    assert.equal(f.store.getQuota('codex'), undefined);
