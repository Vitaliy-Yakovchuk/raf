      "usage": "raf agent run --id <id> --type <type> --project <project> --features <features> [<features> ...] --phase <phase> --complexity <complexity> --tasks <tasks> [<tasks> ...] [--notify <notify>]"
    }
  ],
  "reportStatuses": [
    {
      "id": "succeeded",
      "description": "Доручення виконано успішно",
      "event": "agent.succeeded"
    },
    {
      "id": "failed",
      "description": "Доручення не виконано повністю або процес упав без валідного succeeded",
      "event": "agent.failed"
    }
  ]
}
