{
  "program": "raf",
  "commands": [
    {
      "path": [
        "help"
      ],
      "description": "Детальна довідка для заданого шляху команди; --help тієї самої команди повертає еквівалентний результат.",
      "output": "JSON довідки: usage, parameters/defaults/values, prerequisites, sideEffects, output, errors, examples та спільні константи.",
      "errors": "Ненульовий код із errorCodes та JSON code/message/details/remediation. За часткового виконання перевірте completed/pending і retrySafe перед повтором; довідка: raf help help.",
      "prerequisites": "Скомпільований артефакт цього покоління. raf, raf --help і raf help показують корінь; raf help <path> та raf <path> --help еквівалентні.",
      "sideEffects": "Лише читає каталог; SQLite, служба, Git, секрети й зовнішні runners не потрібні.",
      "examples": [
        "raf help"
      ],
      "errorCodes": [
        {
          "id": "UNKNOWN_COMMAND",
          "description": "Невідомий шлях команди або довідки.",
          "exitCode": 1
        },
        {
          "id": "UNKNOWN_ARGUMENT",
          "description": "Невідомий аргумент або зайве позиційне значення.",
          "exitCode": 1
        },
        {
          "id": "DUPLICATE_ARGUMENT",
          "description": "Одиничний параметр передано повторно.",
          "exitCode": 1
        },
        {
          "id": "MISSING_VALUE",
          "description": "Параметр потребує непорожнього значення.",
          "exitCode": 1
        },
        {
          "id": "MISSING_REQUIRED",
          "description": "Не задано обов’язковий параметр.",
          "exitCode": 1
        },
        {
          "id": "INVALID_VALUE",
          "description": "Значення або комбінація параметрів не підтримуються.",
          "exitCode": 1
        },
        {
          "id": "HANDLER_FAILED",
          "description": "Обробник завершився помилкою; причина невідома.",
          "exitCode": 1
        },
        {
          "id": "HANDLER_UNAVAILABLE",
          "description": "Обробник команди недоступний.",
          "exitCode": 1
        },
        {
          "id": "COMMAND_UNAVAILABLE",
          "description": "Команда недоступна в обраному поколінні raf.",
          "exitCode": 1
        },
        {
          "id": "CATALOG_UNAVAILABLE",
          "description": "Скомпільований каталог відсутній або пошкоджений.",
          "exitCode": 1
        },
        {
          "id": "CONFIGURATION_INVALID",
          "description": "Конфігурація відсутня або не відповідає контракту.",
          "exitCode": 1
        },
        {
          "id": "PRODUCTION_ENTRY_FAILED",
          "description": "Не вдалося завершити production-операцію raf.",
          "exitCode": 1
        },
        {
          "id": "STATE_CONTEXT_REFUSED",
          "description": "Не доведено право цього покоління на контекст стану.",
          "exitCode": 1
        },
        {
          "id": "TIMING_FAILED",
          "description": "timing failed",
          "exitCode": 1
        }
      ],
      "handlerName": "help",
      "parameters": [],
      "valueSources": {},
