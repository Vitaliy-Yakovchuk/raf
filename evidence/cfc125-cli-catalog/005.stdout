{
  "program": "raf",
  "commands": [
    {
      "path": [
        "agent",
        "message"
      ],
      "description": "Передати повідомлення агенту з перевіреним відправником.",
      "parameters": [
        {
          "name": "to",
          "option": "--to",
          "required": true,
          "multiple": false,
          "description": "Адреса одержувача з ps.",
          "type": "string",
          "requirement": "required"
        },
        {
          "name": "text",
          "option": "--text",
          "required": true,
          "multiple": false,
          "description": "Текст повідомлення.",
          "type": "string",
          "requirement": "required"
        }
      ],
      "output": "JSON receipt; exit 0 лише для підтвердженої доставки.",
      "errors": "Ненульовий код із errorCodes та JSON code/message/details/remediation. За часткового виконання перевірте completed/pending і retrySafe перед повтором; довідка: raf help agent message.",
      "prerequisites": "Адресу одержувача отримано через agent ps; відправник перевірений та має право доставки.",
      "sideEffects": "Доставляє текст активному адресату через його адаптер; receipt підтверджує доставку за контрактом каналу.",
      "examples": [
        "raf agent message --to main --text \"Приклад повідомлення\""
      ],
      "errorCodes": [
        {
          "id": "UNKNOWN_COMMAND",
          "description": "Невідомий шлях команди або довідки.",
          "exitCode": 1
        },
        {
          "id": "UNKNOWN_ARGUMENT",
          "description": "Невідомий аргумент або зайве позиційне значення.",
          "exitCode": 1
        },
        {
          "id": "DUPLICATE_ARGUMENT",
          "description": "Одиничний параметр передано повторно.",
          "exitCode": 1
        },
        {
          "id": "MISSING_VALUE",
          "description": "Параметр потребує непорожнього значення.",
          "exitCode": 1
        },
        {
          "id": "MISSING_REQUIRED",
          "description": "Не задано обов’язковий параметр.",
          "exitCode": 1
        },
        {
          "id": "INVALID_VALUE",
          "description": "Значення або комбінація параметрів не підтримуються.",
          "exitCode": 1
        },
        {
          "id": "HANDLER_FAILED",
          "description": "Обробник завершився помилкою; причина невідома.",
          "exitCode": 1
        },
        {
          "id": "HANDLER_UNAVAILABLE",
          "description": "Обробник команди недоступний.",
          "exitCode": 1
        },
        {
