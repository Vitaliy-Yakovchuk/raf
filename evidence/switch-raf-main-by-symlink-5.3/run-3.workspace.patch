+      const snapshot = await context.store.read();
+      const pending = snapshot.transition?.status === 'waiting';
+      const ownerId = pending ? snapshot.transition!.newOwners[role] : snapshot.activeOwners[role];
+      const owner = snapshot.owners[ownerId];
+      if (!await context.runtime.isAlive(owner)) {
