diff --git a/test/test-run-completed-cleanup.test.ts b/test/test-run-completed-cleanup.test.ts
new file mode 100644
index 0000000..a5f3e67
--- /dev/null
+++ b/test/test-run-completed-cleanup.test.ts
@@ -0,0 +1,119 @@
+import assert from 'node:assert/strict';
+import { execFileSync } from 'node:child_process';
+import { cpSync, mkdirSync, mkdtempSync, readFileSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';
+import { registerHooks } from 'node:module';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import test from 'node:test';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+import { openStateStore } from '../src/state-store.ts';
+import { readDatabaseTable, type DatabaseReadExecution } from '../src/database-read-limit.ts';
+
+const source = fileURLToPath(new URL('../', import.meta.url));
+const change = 'fix-raf-test-run-selection-aggregate';
+
+for (const groupCount of [120, 3]) {
+  test(`completed test cleanup preserves protected records with ${groupCount} groups and more than 50 usage records`, async t => {
+    const root = mkdtempSync(join(tmpdir(), 'raf-completed-cleanup-'));
+    const workspace = join(root, 'raf-hotfix');
+    const home = join(root, 'control-home');
+    const group = `${change}/selection-aggregate`;
+    const key = { project: 'raf', workspace, group };
+    const previousCwd = process.cwd();
+    const previousHome = process.env.HOME;
+    const previousQaHome = process.env.RAF_QA_HOME;
+    let unitHome: string | undefined;
+    t.after(() => {
+      process.chdir(previousCwd);
+      if (previousHome === undefined) delete process.env.HOME; else process.env.HOME = previousHome;
+      if (previousQaHome === undefined) delete process.env.RAF_QA_HOME; else process.env.RAF_QA_HOME = previousQaHome;
+      if (unitHome) rmSync(unitHome, { recursive: true, force: true });
+      rmSync(root, { recursive: true, force: true });
+    });
+    cpSync(join(source, '..', 'conf'), join(root, 'conf'), { recursive: true });
+    const projectsPath = join(root, 'conf/projects.json');
+    const projects = JSON.parse(readFileSync(projectsPath, 'utf8'));
+    projects.projects.raf.path = 'raf-main';
+    projects.projects.raf.branchPaths = { main: 'raf-main', develop: 'raf-develop', hotfix: 'raf-hotfix' };
+    writeFileSync(projectsPath, JSON.stringify(projects));
+    for (const path of ['raf-main', 'raf-develop', 'raf-hotfix', 'control-home']) mkdirSync(join(root, path), { mode: 0o700 });
+    cpSync(join(source, 'src'), join(workspace, 'src'), { recursive: true });
+    symlinkSync(join(source, 'node_modules'), join(workspace, 'node_modules'));
+    writeFileSync(join(workspace, 'package.json'), '{"type":"module"}');
+    mkdirSync(join(workspace, 'bin'));
+    writeFileSync(join(workspace, 'bin/raf.ts'), '');
+    const git = (...args: string[]) => execFileSync('git', ['-C', workspace, ...args], { stdio: 'pipe' });
+    git('init', '--quiet', '--initial-branch=hotfix');
+    git('-c', 'user.name=Unit', '-c', 'user.email=unit@example.invalid', 'commit', '--quiet', '--allow-empty', '-m', 'fixture');
+    const stateName = JSON.parse(readFileSync(join(root, 'conf/raf.json'), 'utf8')).state.fileName;
+    const controlStore = openStateStore(join(home, '.raf', stateName));
+    t.after(() => controlStore.close());
+    const db = controlStore.startupContextDatabase;
+    const caller = { pid: process.pid, startedAt: 'unit-process-start' };
+    const assignment = { runId: 'unit-caller', agentId: 'unit-agent', type: 'hotfix', phase: 'hotfix', project: 'raf', workspace, branch: 'hotfix', changes: [change] };
+    const control = { ancestors: [caller], sessions: [{ process: caller, state: 'running', assignment }], activeChanges: [change], groups: [key], workspaces: [{ project: 'raf', workspace, branch: 'hotfix' }] };
+    const runtimeUrl = pathToFileURL(join(workspace, 'src/test-run-runtime.ts')).href;
+    const bridgeKey = `cleanup-fixture:${root}`;
+    const globals = globalThis as Record<string, any>;
+    const originalResult = { runId: 'unit-result', outcome: 'passed', groupSnapshot: 'unavailable' };
+    globals[bridgeKey] = async (ports: any) => {
+      unitHome = ports.context.home;
+      await ports.runtime.state.transaction((tx: any) => {
+        for (let index = 0; index < groupCount; index++) tx.put({
+          key: { ...key, group: `${change}/fixture-${index}` }, timeoutCount: 0, state: 'idle', knownRed: [], unexecuted: [],
+          lastResult: index === 0 ? { runId: 'retained-last' } : null,
+          inFlight: index === groupCount - 1 ? { runId: 'retained-flight' } : null,
+        });
+      });
+      const insert = db.prepare('INSERT INTO resource_usage(kind, run_id, payload) VALUES (?, ?, ?)');
+      for (let index = 0; index < 120; index++) insert.run('test', `expired-${index}`, JSON.stringify({ context: { resultStatePath: ports.context.statePath }, finishedAt: 1 }));
+      for (const [kind, runId, path, finishedAt] of [
+        ['test', 'retained-last', ports.context.statePath, 1],
+        ['test', 'retained-flight', ports.context.statePath, 1],
+        ['test', 'running', ports.context.statePath, null],
+        ['test', 'foreign', join(root, 'other-state.sqlite'), 1],
+        ['agent', 'agent-record', ports.context.statePath, 1],
+      ]) insert.run(kind, runId, JSON.stringify({ context: { resultStatePath: path }, finishedAt }));
+      ports.stdout(JSON.stringify(originalResult));
+      return 0;
+    };
+    const doubles: Record<string, string> = {
+      './production-runtime.ts': `export const sandboxTestControlSnapshot = async () => (${JSON.stringify(control)});`,
+      './sandbox-test-caller.ts': `export const resolveSandboxTestCaller = () => (${JSON.stringify(assignment)});`,
+      './test-run-resource-runtime.ts': 'export const createTestRunResourcePort = () => ({ list: async () => [] });',
+      './test-run-queue-runtime.ts': 'export const createTestRunQueuePort = () => ({});',
+    };
+    const cliUrl = pathToFileURL(join(workspace, 'src/test-run-cli.ts')).href;
+    const prefix = `cleanup-fixture:${root}:`;
+    const hooks = registerHooks({
+      resolve(specifier, context, next) {
+        if (context.parentURL === runtimeUrl && doubles[specifier]) return { url: prefix + specifier, shortCircuit: true };
+        return next(specifier, context);
+      },
+      load(url, context, next) {
+        if (url.startsWith(prefix)) return { format: 'module', source: doubles[url.slice(prefix.length)], shortCircuit: true };
+        if (url === cliUrl) return { format: 'module', shortCircuit: true, source: `export const runTestRunCli = (argv, ports) => globalThis[${JSON.stringify(bridgeKey)}](ports);` };
+        return next(url, context);
+      },
+    });
+    t.after(() => { hooks.deregister(); delete globals[bridgeKey]; });
+    process.chdir(workspace);
+    process.env.HOME = home;
+    process.env.RAF_QA_HOME = home;
+    const runtime = await import(runtimeUrl);
+    const { observeDatabaseReads } = await import(pathToFileURL(join(workspace, 'src/database-read-limit.ts')).href);
+    const reads: DatabaseReadExecution[] = [];
+    const result = await observeDatabaseReads(() => runtime.runConfiguredTestRun(['--project', 'raf', '--phase', 'hotfix', '--group', group],
+      { orchestratorRoot: root, homeDirectory: home, commandTimingOwner: 'production' }), (read: DatabaseReadExecution) => reads.push(read));
+    assert.equal(result.exitCode, 0, result.stderr + '\n' + result.stdout);
+    assert.deepEqual(JSON.parse(result.stdout), originalResult, 'Cleanup must preserve the completed CLI result');
+    assert.deepEqual(readDatabaseTable(db, 'resource_usage').map(row => row.run_id).sort(),
+      ['agent-record', 'foreign', 'retained-flight', 'retained-last', 'running']);
+    const cleanupReads = reads.filter(read => read.callsite.includes('test-run-runtime.ts') && /test_run_groups|resource_usage/.test(read.queryId));
+    assert.ok(cleanupReads.length > 0);
+    for (const read of cleanupReads) {
+      assert.equal(read.limit, 50);
+      assert.ok(read.rowsRead <= 50);
+    }
+  });
+}
