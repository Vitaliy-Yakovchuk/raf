            },
            {
              "id": "dash"
            },
            {
              "id": "ramus-cloud"
            },
            {
              "id": "raf"
            },
            {
              "id": "orchestrator"
            }
          ],
          "requirement": "required"
        },
        {
          "name": "phase",
          "option": "--phase",
          "required": true,
          "multiple": false,
          "description": "Фаза прогону.",
          "type": "string",
          "values": [
            {
              "id": "main",
              "description": "Головний координатор"
            },
            {
              "id": "hotfix",
              "description": "Вузьке виправлення"
            },
            {
              "id": "spec",
              "description": "Вимоги, контракти й план"
            },
            {
              "id": "design",
              "description": "UI/UX та макети"
            },
            {
              "id": "test-scaffold",
              "description": "Тести, інваріанти й каркас"
            },
            {
              "id": "implement",
              "description": "Реалізація фічі"
            },
            {
              "id": "coordinator",
              "description": "Ведення напряму та його виконавців"
            },
            {
              "id": "qa",
              "description": "QA з погляду користувача"
            },
            {
              "id": "context-review",
              "description": "Аналіз стартового контексту за подією context-review.due; тип агента spec"
            },
            {
              "id": "red",
              "description": "Початковий unit-red, який підтверджує main"
            },
            {
              "id": "integration",
              "description": "Фаза локального integration-прогону; не тип агента або етап розробки"
            }
          ],
          "requirement": "required"
        },
        {
          "name": "group",
          "option": "--group",
          "required": true,
          "multiple": false,
          "description": "Стабільна група <change>/<group>: unit-група або точний preset integration-сценарію.",
          "type": "string",
          "requirement": "required"
        },
        {
          "name": "files",
          "option": "--files",
          "required": false,
          "multiple": true,
          "description": "Точні відносні файли групи одним списком після одного --files (прапорець не повторювати).",
          "type": "string",
