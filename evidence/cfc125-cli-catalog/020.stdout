{
  "program": "raf",
  "commands": [
    {
      "path": [
        "runner",
        "list"
      ],
      "valueSources": {
        "runner": [
          {
            "id": "codex",
            "initialEnabled": true
          },
          {
            "id": "grok",
            "initialEnabled": true
          },
          {
            "id": "agy",
            "initialEnabled": true
