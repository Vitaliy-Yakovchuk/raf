          "PRODUCTION_ENTRY_FAILED",
          "STATE_CONTEXT_REFUSED",
          "TIMING_FAILED",
          "TEST_RUN_PLAN_CHANGED"
        ]
      },
      "usage": "raf test run --project <project> --phase <phase> --group <group> [--files <files> [<files> ...]] [--only <only> [<only> ...]]"
    }
