+
+const codexCreditModal = [
+  'Approaching rate limits',
+  'Switch to gpt-6-luna for lower credit usage?',
+  '› 1. Switch to gpt-6-luna',
+  '  2. Keep current model',
+  '  3. Keep current model (never show again)',
+].join('\n');
+
+test('running codex lower credit modal keeps the current model with key 2 and continues the session', async t => {
+  const f = await fixture(t, codexCreditModal, true, 'codex');
+  assert.equal((await f.services.control.ps()).length, 1);
+  assert.equal(f.current().state, 'running');
+  assert.ok(f.calls.some(args => args.includes('send-keys')), 'Observation must dismiss the lower credit modal');
+  assert.equal(f.store.getQuota('codex'), undefined);
+  assert.equal(f.calls.some(args => args.includes('kill-session')), false);
+  await f.services.control.ps();
+  assert.equal(f.calls.filter(args => args.includes('send-keys')).length, 1);
+});
+
+for (const scenario of [
+  { name: 'another pane', screen: codexCreditModal, owned: false },
