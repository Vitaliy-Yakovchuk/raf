+  const owner: ComponentOwner = { ownerId: randomUUID(), epoch, role, generation: target, phase: 'starting' };
+  state.owners[owner.ownerId] = owner;
+  return owner;
+}
+
+function activeOwner(state: HandoverState, token: OwnerToken): ComponentOwner {
+  const owner = state.owners[token.ownerId];
