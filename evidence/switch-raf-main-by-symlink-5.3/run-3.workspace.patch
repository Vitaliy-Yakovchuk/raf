+          const currentId = pending ? current.transition?.id === snapshot.transition!.id && current.transition.newOwners[role] : current.activeOwners[role];
+          if (!currentId) fail('MAIN_HANDOVER_STALE', 'Main handover changed during recovery');
+          const currentOwner = current.owners[currentId];
+          if (!sameToken(currentOwner, owner)) return null;
+          const next = allocateOwner(current, role, owner.generation);
+          currentOwner.phase = 'retired';
+          if (pending) {
+            current.transition!.newOwners[role] = next.ownerId;
+            if (current.activeOwners[role] === owner.ownerId) current.activeOwners[role] = next.ownerId;
+          } else current.activeOwners[role] = next.ownerId;
+          return copy(next);
+        });
+        if (replacement) await context.runtime.start(copy(replacement), [...duties[role]]);
+      }
+      if (!pending) {
+        const latest = await context.store.read();
+        const active = latest.owners[latest.activeOwners[role]];
+        if (!await ownerReady(context, active)) return { status: 'waiting', reason: 'Recovered main owner is not ready: ' + role };
+        await context.store.transaction(current => {
+          if (current.activeOwners[role] === active.ownerId && sameToken(current.owners[active.ownerId], active)) current.owners[active.ownerId].phase = 'active';
