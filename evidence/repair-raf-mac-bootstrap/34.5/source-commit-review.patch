diff --git a/src/test-run-darwin-process.ts b/src/test-run-darwin-process.ts
new file mode 100644
index 0000000..4fad620
--- /dev/null
+++ b/src/test-run-darwin-process.ts
@@ -0,0 +1,50 @@
+import { execFileSync, spawnSync } from 'node:child_process';
+
+const darwinStartPrefix = 'darwin-utc:';
+const darwinBootPrefix = 'darwin-boot:';
+
+export function darwinBoot(value: string): string {
+  const numeric = value.match(/^\{\s*sec\s*=\s*(\d+),\s*usec\s*=\s*(\d+)\s*\}/);
+  if (!numeric) throw new Error('Invalid Darwin boot identity');
+  return `${darwinBootPrefix}${numeric[1]}:${numeric[2]}`;
+}
+
+export function darwinStart(value: string): string {
+  const normalized = value.replace(/\s+/g, ' ').trim();
+  if (!/^[A-Z][a-z]{2} [A-Z][a-z]{2} \d{1,2} \d{2}:\d{2}:\d{2} \d{4}$/.test(normalized) || Number.isNaN(Date.parse(normalized + ' UTC'))) throw new Error('Invalid Darwin process start identity');
+  return darwinStartPrefix + normalized;
+}
+
+export function darwinTestBoot(): string {
+  return darwinBoot(execFileSync('sysctl', ['-n', 'kern.boottime'], { encoding: 'utf8' }).trim());
+}
+
+export function sameDarwinTestBoot(recorded: string, current: string): boolean {
+  return (recorded.startsWith('{') ? darwinBoot(recorded) : recorded) === current;
+}
+
+export function darwinTestStart(pid: number): string | null {
+  const result = spawnSync('ps', ['-p', String(pid), '-o', 'stat=,lstart='], { encoding: 'utf8', env: { ...process.env, TZ: 'UTC', LC_ALL: 'C' } });
+  if (result.error) throw result.error;
+  if (result.status === 1 && !result.stdout.trim()) return null;
+  if (result.status !== 0) throw new Error('Client identity scan failed');
+  const row = result.stdout.trim().match(/^(\S+)\s+(.+)$/);
+  if (!row) throw new Error('Invalid client process status');
+  return /^[ZX]/.test(row[1]) ? null : darwinStart(row[2]);
+}
+
+export function darwinTestRows(): { pid: number; parent: number; group: number; start: string; ramBytes: number }[] {
+  const output = execFileSync('ps', ['-axo', 'pid=,ppid=,pgid=,stat=,rss=,lstart='], { encoding: 'utf8', env: { ...process.env, TZ: 'UTC', LC_ALL: 'C' } });
+  return output.split('\n').filter(line => line.trim()).flatMap(line => {
+    const row = line.match(/^\s*(\d+)\s+(\d+)\s+(\d+)\s+(\S+)\s+(\d+)\s+(.+?)\s*$/);
+    if (!row) throw new Error('Malformed client identity scan');
+    return /^[ZX]/.test(row[4]) ? [] : [{ pid: Number(row[1]), parent: Number(row[2]), group: Number(row[3]), ramBytes: Number(row[5]) * 1024, start: darwinStart(row[6]) }];
+  });
+}
+
+export function darwinTestTree(pgid: number): { pid: number; start: string }[] {
+  const rows = darwinTestRows();
+  const owned = new Set([pgid, ...rows.filter(row => row.group === pgid).map(row => row.pid)]);
+  for (let size = -1; size !== owned.size;) { size = owned.size; for (const row of rows) if (owned.has(row.parent)) owned.add(row.pid); }
+  return rows.filter(row => owned.has(row.pid));
+}
