+++ b/src/test-run-quality.ts
@@ -0,0 +1,207 @@
+import type { TestId, TestRunCleanup, TestRunGroup, TestRunGroupKey, TestRunPlan, TestRunResult, UnitTestPolicy } from './test-runs.ts';
+
+export interface QualityFunction {
+  id: string;
+  path: string;
+  startByte: number;
+  endByte: number;
+}
+
+export interface QualityMutation {
+  siteId: string;
+  functionId: string;
+  path: string;
+  startByte: number;
+  endByte: number;
+  beforeBase64: string;
+  afterBase64: string;
+}
+
+export interface QualityRequest {
+  version: 1;
+  mode: 'baseline' | 'mutant';
+  source: { baseRevision: string; revision: string; files: { path: string; sha256: string }[] };
+  changedFunctions: QualityFunction[];
+  baselineRunId?: string;
+  mutant?: QualityMutation;
+}
+
+export interface QualityInput {
+  path: string;
+  bytes: Uint8Array;
+  realpath: string;
+  role: 'source' | 'test' | 'config' | 'dependency' | 'control';
+}
+
+export interface QualitySnapshot {
+  digest: string;
+  inputs: QualityInput[];
+}
+
+export interface QualityContext {
+  runId: string;
+  owner: string;
+  canonicalWorkspace: string;
+  profileId: string;
+  profileCwd: string;
+  selection: TestRunPlan['selection'];
+  selectionDigest: string;
+  configDigest: string;
+  dependencyDigest: string;
+  sourceAdapter: { id: string; version: string };
+  siteSelector: { id: string; version: string };
+}
+
+export interface QualityExecution {
+  runId: string;
+  owner: string;
+  canonicalWorkspace: string;
+  executionRoot: string;
+  cwd: string;
+  sourceSnapshotDigest: string;
+  executionSnapshotDigest: string;
+  selection: TestRunPlan['selection'];
+  inputs: QualityInput[];
+  selectedSites: QualityMutation[];
+}
+
+export interface QualityBaseline {
+  runId: string;
+  owner: string;
+  sourceSnapshotDigest: string;
+  selectionDigest: string;
+  configDigest: string;
+  dependencyDigest: string;
+  producer: { id: string; version: string };
+  result: Pick<TestRunResult, 'outcome' | 'exitCode' | 'timedOut' | 'cleanup' | 'unknown' | 'unexecuted'>;
+}
+
+export interface QualityTransportPorts {
+  snapshot(): Promise<QualitySnapshot>;
+  readCurrent(path: string): Promise<Uint8Array>;
+  loadBaseline(runId: string): Promise<QualityBaseline | null>;
+  selectSites(snapshot: QualitySnapshot, functions: QualityFunction[]): Promise<{ supported: boolean; reason?: string; sites: QualityMutation[] }>;
+  createPrivateCopy(snapshot: QualitySnapshot, runId: string, owner: string): Promise<{ root: string; inputs: QualityInput[] }>;
+  removePrivateCopy(root: string, owner: string): Promise<void>;
+}
+
+export interface QualityLoadedSource {
+  path: string;
+  resolvedPath: string;
+  inputSha256: string;
+  transformedSha256: string | null;
+  mapping: string | null;
+  loaded: boolean;
+  stage: 'load' | 'transform';
+  runId: string;
+}
+
+export interface QualityCoverage {
+  runId: string;
+  sourceSnapshotDigest: string;
+  selectionDigest: string;
+  configDigest: string;
+  dependencyDigest: string;
+  producer: { id: string; version: string; complete: boolean; exitCode: number | null };
+  artifact: { path: string; sha256: string; actualSha256: string; format: string; createdByRunId: string } | null;
+  functions: { id: string; unit: 'function' | 'line' | 'branch'; hits: number; denominator: number; sourceSha256: string; mapped: boolean }[];
+  omissions: string[];
+}
+
+export interface QualityCoverageDecision {
+  accepted: boolean;
+  reason: string | null;
+  functions: { id: string; status: 'covered' | 'uncovered' | 'missing' | 'unsupported'; hits: number | null; denominator: number | null }[];
+}
+
+export type QualityFailure = 'refusal' | 'setup' | 'compile' | 'assertions' | 'timeout' | 'interruption';
+export type MutationDisposition = 'not-applicable' | 'survived' | 'assertion-killed' | 'compile-failed' | 'setup-failed' | 'timed-out' | 'refused' | 'unverified';
+export interface QualityRunFacts {
+  mode: 'baseline' | 'mutant';
+  runId: string;
+  target: { path: string; sha256: string };
+  baselineGreen: boolean;
+  siteCount: number;
+  loadedSources: QualityLoadedSource[];
+  events: { origin: 'test-body' | 'transform' | 'import' | 'hook' | 'unknown' | 'broker'; test?: TestId; path?: string; inputSha256?: string; message: string }[];
+  protocolComplete: boolean;
+  cleanup: TestRunCleanup;
+  exitCode: number | null;
+  timedOut: boolean;
+  interrupted: boolean;
+  rawUpstreamOutcome?: string;
+}
+
+export interface QualityClassification {
+  outcome: TestRunResult['outcome'] | 'compile-failed';
+  failureKinds: QualityFailure[];
+  knownRed: TestId[];
+  mutationDisposition: MutationDisposition;
+  reason: string | null;
+  nextAction: TestRunResult['nextAction'];
+  rawUpstreamOutcome?: string;
+}
+
+export interface QualityEvidence {
+  mode: QualityRequest['mode'];
+  baselineRunId: string | null;
+  sourceSnapshotDigest: string | null;
+  executionSnapshotDigest: string | null;
+  mutant: { siteId: string; functionId: string; path: string; beforeSha256: string; afterSha256: string } | null;
+  loadedSources: QualityLoadedSource[];
+  coverage: QualityCoverage | { unavailableReason: string };
+  mutationDisposition: MutationDisposition;
+  reason: string | null;
+}
+
+export type QualityTestRunResult = Omit<TestRunResult, 'outcome' | 'failureKinds'> & {
+  outcome: QualityClassification['outcome'];
+  failureKinds: QualityFailure[];
+  quality: QualityEvidence;
+};
+
+export interface QualityObservation {
+  runId: string;
+  agentId: string;
+  phase: string;
+  mode: 'baseline' | 'mutant';
+  sourceSnapshotDigest: string;
+  executionSnapshotDigest: string;
+  classification: QualityClassification;
+}
+
+export interface QualityGroup {
+  aggregate: TestRunGroup;
+  observations: QualityObservation[];
+}
+
+export interface QualityRecoveryCopy {
+  root: string;
+  owner: string;
+  runId: string;
+  tree: 'terminated' | 'active' | 'unknown';
+}
+
+export function parseQualityRequest(value: unknown): QualityRequest {
+  throw new Error('NotImplemented');
+}
+
+export async function prepareQualityExecution(request: QualityRequest, context: QualityContext, ports: QualityTransportPorts): Promise<QualityExecution> {
+  throw new Error('NotImplemented');
+}
+
+export function verifyQualityCoverage(coverage: QualityCoverage, baseline: QualityBaseline, functions: QualityFunction[], sourceHashes: Record<string, string>): QualityCoverageDecision {
+  throw new Error('NotImplemented');
+}
+
+export function classifyQualityRun(facts: QualityRunFacts): QualityClassification {
+  throw new Error('NotImplemented');
+}
+
+export function recordQualityObservation(group: QualityGroup, key: TestRunGroupKey, observation: QualityObservation, policy: UnitTestPolicy): QualityGroup {
+  throw new Error('NotImplemented');
+}
+
+export async function recoverQualityCopies(copies: QualityRecoveryCopy[], owner: string, ports: Pick<QualityTransportPorts, 'removePrivateCopy'>): Promise<string[]> {
+  throw new Error('NotImplemented');
+}
diff --git a/test/helpers/quality-fixture.ts b/test/helpers/quality-fixture.ts
new file mode 100644
index 0000000..403cb89
--- /dev/null
+++ b/test/helpers/quality-fixture.ts
@@ -0,0 +1,55 @@
+import { createHash } from 'node:crypto';
+import type { QualityBaseline, QualityContext, QualityCoverage, QualityRequest, QualityRunFacts, QualitySnapshot, QualityTransportPorts } from '../../src/test-run-quality.ts';
+
+export const hash = (value: string | Uint8Array) => createHash('sha256').update(value).digest('hex');
+export const source = 'export const answer = () => 42; export const neighbor = () => 7;\n';
+export const targetPath = 'src/answer.ts';
+export const selected = { id: 'answer', path: targetPath, startByte: 0, endByte: source.indexOf(';') + 1 };
+export const mutation = { siteId: 'answer/return/42', functionId: selected.id, path: targetPath, startByte: source.indexOf('42'), endByte: source.indexOf('42') + 2, beforeBase64: Buffer.from('42').toString('base64'), afterBase64: Buffer.from('41').toString('base64') };
+export const testId = { file: 'test/answer.test.ts', name: 'required answer' };
+export const group = 'adopt-ub-mode-quality-gates/quality-transport';
+export const workspace = '/fixture/project';
+export const mutated = source.replace('42', '41');
+
+export function request(mode: 'baseline' | 'mutant' = 'mutant'): QualityRequest {
+  return { version: 1, mode, source: { baseRevision: 'a'.repeat(40), revision: 'b'.repeat(40), files: [{ path: targetPath, sha256: hash(source) }] }, changedFunctions: [{ ...selected }], ...(mode === 'mutant' ? { baselineRunId: 'baseline-1', mutant: { ...mutation } } : {}) };
+}
+
+export function context(): QualityContext {
+  return { runId: 'mutant-1', owner: 'trusted-wrapper', canonicalWorkspace: workspace, profileId: 'node', profileCwd: '.', selection: { files: [testId.file], testIds: [] }, selectionDigest: hash('selection'), configDigest: hash('config'), dependencyDigest: hash('dependencies'), sourceAdapter: { id: 'node-source', version: 'fixture-reviewed' }, siteSelector: { id: 'typescript-function', version: 'fixture-reviewed' } };
+}
+
+export function baseline(): QualityBaseline {
+  return { runId: 'baseline-1', owner: context().owner, sourceSnapshotDigest: hash('snapshot'), selectionDigest: context().selectionDigest, configDigest: context().configDigest, dependencyDigest: context().dependencyDigest, producer: { id: 'v8', version: 'fixture-pinned' }, result: { outcome: 'passed', exitCode: 0, timedOut: false, cleanup: { complete: true, remainingPids: [] }, unknown: [], unexecuted: [] } };
+}
+
+export function transport() {
+  const snapshot: QualitySnapshot = { digest: hash('snapshot'), inputs: [
+    { path: targetPath, bytes: Buffer.from(source), realpath: `${workspace}/${targetPath}`, role: 'source' },
+    { path: testId.file, bytes: Buffer.from('assert.equal(answer(), 42)'), realpath: `${workspace}/${testId.file}`, role: 'test' },
+    { path: 'runner.config.ts', bytes: Buffer.from('trusted config'), realpath: `${workspace}/runner.config.ts`, role: 'config' },
+  ] };
+  const saved = baseline();
+  const calls = { copies: 0, removed: [] as string[], selected: [] as string[] };
+  const ports: QualityTransportPorts = {
+    snapshot: async () => structuredClone(snapshot),
+    readCurrent: async path => structuredClone(snapshot.inputs.find(input => input.path === path)!.bytes),
+    loadBaseline: async id => id === saved.runId ? structuredClone(saved) : null,
+    selectSites: async (_snapshot, functions) => { calls.selected.push(...functions.map(fn => fn.id)); return { supported: true, sites: [{ ...mutation }] }; },
+    createPrivateCopy: async snap => { calls.copies++; return { root: '/fixture/private/run-1', inputs: structuredClone(snap.inputs) }; },
+    removePrivateCopy: async root => { calls.removed.push(root); },
+  };
+  return { snapshot, saved, calls, ports };
+}
+
+export function coverage(): QualityCoverage {
+  return { runId: 'baseline-1', sourceSnapshotDigest: baseline().sourceSnapshotDigest, selectionDigest: context().selectionDigest, configDigest: context().configDigest, dependencyDigest: context().dependencyDigest,
+    producer: { ...baseline().producer, complete: true, exitCode: 0 }, artifact: { path: '/fixture/private/baseline-1/coverage/lcov.info', sha256: hash('coverage'), actualSha256: hash('coverage'), format: 'lcov', createdByRunId: 'baseline-1' },
+    functions: [{ id: selected.id, unit: 'function', hits: 1, denominator: 1, sourceSha256: hash(source), mapped: true }], omissions: [] };
+}
+
+export function facts(overrides: Partial<QualityRunFacts> = {}): QualityRunFacts {
+  return { mode: 'mutant', runId: 'mutant-1', target: { path: targetPath, sha256: hash(mutated) }, baselineGreen: true, siteCount: 1,
+    loadedSources: [{ path: targetPath, resolvedPath: '/fixture/private/run-1/src/answer.ts', inputSha256: hash(mutated), transformedSha256: hash('compiled mutant'), mapping: 'source-map-sha', loaded: true, stage: 'load', runId: 'mutant-1' }],
+    events: [], protocolComplete: true, cleanup: { complete: true, remainingPids: [] }, exitCode: 0, timedOut: false, interrupted: false, ...overrides };
+}
diff --git a/test/quality-coverage-provenance.test.ts b/test/quality-coverage-provenance.test.ts
new file mode 100644
index 0000000..66a98c3
--- /dev/null
+++ b/test/quality-coverage-provenance.test.ts
@@ -0,0 +1,71 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { verifyQualityCoverage } from '../src/test-run-quality.ts';
+import { baseline, coverage, hash, selected, source, targetPath } from './helpers/quality-fixture.ts';
+
+const check = (report = coverage(), green = baseline()) => verifyQualityCoverage(report, green, [selected], { [targetPath]: hash(source) });
+
+test('T07 fresh complete baseline coverage binds producer, run, source and selection', () => {
+  assert.deepEqual(check(), { accepted: true, reason: null, functions: [{ id: selected.id, status: 'covered', hits: 1, denominator: 1 }] });
+});
+
+for (const field of ['runId', 'sourceSnapshotDigest', 'selectionDigest', 'configDigest', 'dependencyDigest'] as const) {
+  test(`T07 stale coverage ${field} is unavailable, never zero coverage`, () => {
+    const report = coverage(); report[field] = 'another-run-or-input';
+    const result = check(report);
+    assert.equal(result.accepted, false);
+    assert.ok(result.reason);
+    assert.ok(result.functions.every(fn => fn.status !== 'covered' && fn.status !== 'uncovered'));
+  });
+}
+
+for (const [name, change] of [
+  ['old artifact with fresh mtime', (r: any) => { r.artifact.createdByRunId = 'old-run'; r.artifact.mtime = Date.now(); }],
+  ['artifact hash differs from observed bytes', (r: any) => { r.artifact.actualSha256 = hash('stale lcov'); }],
+  ['missing report', (r: any) => { r.artifact = null; }],
+  ['provider failed', (r: any) => { r.producer.exitCode = 1; }],
+  ['provider incomplete', (r: any) => { r.producer.complete = false; }],
+  ['provider version changed', (r: any) => { r.producer.version = 'different'; }],
+  ['dirty function bytes', (r: any) => { r.functions[0].sourceSha256 = hash('dirty'); }],
+] as const) {
+  test(`T07 ${name} cannot certify coverage`, () => {
+    const report = coverage(); change(report);
+    const decision = check(report);
+    assert.equal(decision.accepted, false);
+    assert.ok(decision.reason);
+  });
+}
+
+for (const [name, change] of [
+  ['failed baseline', (b: any) => { b.result.outcome = 'assertions-failed'; b.result.exitCode = 1; }],
+  ['partial protocol', (b: any) => { b.result.unknown = [{ file: 'test/a.ts', name: 'unknown' }]; }],
+  ['unexecuted test', (b: any) => { b.result.unexecuted = [{ file: 'test/a.ts', name: 'pending' }]; }],
+  ['timeout', (b: any) => { b.result.timedOut = true; }],
+  ['incomplete cleanup', (b: any) => { b.result.cleanup = { complete: false, remainingPids: [123] }; }],
+] as const) {
+  test(`T07/T12 ${name} does not produce usable baseline coverage`, () => {
+    const green = baseline(); change(green);
+    const decision = check(coverage(), green);
+    assert.equal(decision.accepted, false);
+    assert.ok(decision.reason);
+  });
+}
+
+test('T07 a missing function is missing, not covered or uncovered', () => {
+  const report = coverage(); report.functions = [];
+  const decision = check(report);
+  assert.deepEqual(decision.functions, [{ id: selected.id, status: 'missing', hits: null, denominator: null }]);
+});
+
+test('T07 mapped nonzero denominator with zero hits is real uncovered', () => {
+  const report = coverage(); report.functions[0].hits = 0;
+  const decision = check(report);
+  assert.equal(decision.accepted, true);
+  assert.deepEqual(decision.functions, [{ id: selected.id, status: 'uncovered', hits: 0, denominator: 1 }]);
+});
+
+test('T07 unsupported mapping never invents numerical coverage', () => {
+  const report = coverage(); report.functions[0].mapped = false; report.omissions = ['callback mapping unsupported'];
+  const decision = check(report);
+  assert.deepEqual(decision.functions, [{ id: selected.id, status: 'unsupported', hits: null, denominator: null }]);
+});
diff --git a/test/quality-group-accounting.test.ts b/test/quality-group-accounting.test.ts
new file mode 100644
index 0000000..3dfa81c
--- /dev/null
+++ b/test/quality-group-accounting.test.ts
@@ -0,0 +1,76 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { recordQualityObservation } from '../src/test-run-quality.ts';
+import type { QualityGroup, QualityObservation } from '../src/test-run-quality.ts';
+import { fixtureGroup, policy } from './helpers/test-run-fixture.ts';
+import { group, hash, testId, workspace } from './helpers/quality-fixture.ts';
+
+const key = { project: 'raf', workspace, group };
+function state(): QualityGroup {
+  return { aggregate: fixtureGroup({ key, timeoutCount: 1, knownRed: [], unknown: [], inFlight: null }), observations: [] };
+}
+function observation(overrides: Partial<QualityObservation> = {}): QualityObservation {
+  return { runId: 'mutant-1', agentId: 'author-a', phase: 'implement', mode: 'mutant', sourceSnapshotDigest: hash('source'), executionSnapshotDigest: hash('mutant-1'), classification: { outcome: 'assertions-failed', failureKinds: ['assertions'], knownRed: [testId], mutationDisposition: 'assertion-killed', reason: null, nextAction: 'fix-implementation' }, ...overrides };
+}
+
+test('T10 mutant assertion IDs are retained separately from canonical baseline knownRed', () => {
+  const initial = state(), before = structuredClone(initial);
+  const changed = recordQualityObservation(initial, key, observation(), policy);
+  assert.deepEqual(changed.aggregate.key, key);
+  assert.deepEqual(changed.aggregate.knownRed, []);
+  assert.equal(changed.aggregate.timeoutCount, 1);
+  assert.deepEqual(changed.observations[0].classification.knownRed, [testId]);
+  assert.deepEqual(initial, before);
+});
+
+test('T10 baseline facts do not inherit prior mutant assertion failure', () => {
+  const mutant = recordQualityObservation(state(), key, observation(), policy);
+  const green = observation({ runId: 'baseline-2', mode: 'baseline', executionSnapshotDigest: hash('source'), classification: { outcome: 'passed', failureKinds: [], knownRed: [], mutationDisposition: 'not-applicable', reason: null, nextAction: 'complete' } });
+  const changed = recordQualityObservation(mutant, key, green, policy);
+  assert.equal(changed.aggregate.timeoutCount, 1);
+  assert.deepEqual(changed.aggregate.knownRed, []);
+  assert.deepEqual(changed.observations.map(item => item.mode), ['mutant', 'baseline']);
+});
+
+test('T10 changing mutant, agent or phase preserves one canonical timeout count', () => {
+  const first = observation({ classification: { outcome: 'timed-out', failureKinds: ['timeout'], knownRed: [], mutationDisposition: 'timed-out', reason: null, nextAction: 'optimize' } });
+  const initial = state(); initial.aggregate.timeoutCount = 0;
+  const one = recordQualityObservation(initial, key, first, policy);
+  assert.equal(one.aggregate.timeoutCount, 1);
+  const second = { ...first, runId: 'mutant-2', agentId: 'author-b', phase: 'qa', executionSnapshotDigest: hash('mutant-2') };
+  const two = recordQualityObservation(one, key, second, policy);
+  assert.equal(two.aggregate.timeoutCount, 2);
+  assert.deepEqual(two.aggregate.key, key);
+});
+
+test('T10 replaying one durable observation does not count a timeout twice', () => {
+  const timeout = observation({ classification: { outcome: 'timed-out', failureKinds: ['timeout'], knownRed: [], mutationDisposition: 'timed-out', reason: null, nextAction: 'optimize' } });
+  const once = recordQualityObservation(state(), key, timeout, policy);
+  assert.deepEqual(recordQualityObservation(once, key, timeout, policy), once);
+});
+
+test('T10 quality observations cannot reset reached unit remainder policy', () => {
+  const initial = state();
+  initial.aggregate.timeoutCount = policy.maxGroupTimeouts;
+  initial.aggregate.state = 'unverified-remainder';
+  initial.aggregate.unexecuted = [testId];
+  initial.aggregate.unknown = [testId];
+  const changed = recordQualityObservation(initial, key, observation(), policy);
+  assert.equal(changed.aggregate.timeoutCount, policy.maxGroupTimeouts);
+  assert.equal(changed.aggregate.state, 'unverified-remainder');
+  assert.deepEqual(changed.aggregate.unexecuted, [testId]);
+  assert.deepEqual(changed.aggregate.unknown, [testId]);
+});
+
+test('T10 another execution root cannot replace in-flight ownership', () => {
+  const initial = state();
+  initial.aggregate.inFlight = { runId: 'other-live-run', deadlineMs: 1234, processIdentity: 'other-process' };
+  const before = structuredClone(initial);
+  assert.throws(() => recordQualityObservation(initial, key, observation(), policy), error => error instanceof Error && error.message !== 'NotImplemented' && /flight|owner|running/i.test(error.message));
+  assert.deepEqual(initial, before);
+});
+
+test('T09 recovery without full quality facts cannot invent a kill', () => {
+  const partial = observation(); delete (partial as any).classification;
+  assert.throws(() => recordQualityObservation(state(), key, partial, policy), error => error instanceof Error && error.message !== 'NotImplemented' && /quality|evidence|classification|incomplete/i.test(error.message));
+});
diff --git a/test/quality-outcomes.test.ts b/test/quality-outcomes.test.ts
new file mode 100644
index 0000000..7f08163
--- /dev/null
+++ b/test/quality-outcomes.test.ts
@@ -0,0 +1,116 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { classifyQualityRun } from '../src/test-run-quality.ts';
+import { RunnerProtocol } from '../src/test-run-protocol.ts';
+import { formatSandboxTestRunEvidence } from '../src/sandbox-test-run.ts';
+import { facts, hash, mutated, targetPath, testId } from './helpers/quality-fixture.ts';
+import { RunHarness, fixtureRequest, policy } from './helpers/test-run-fixture.ts';
+import { classifyRunnerResult, runTestRun } from '../src/test-runs.ts';
+
+const body = { origin: 'test-body' as const, test: testId, message: 'compile mentioned by product exception' };
+const compile = { origin: 'transform' as const, path: targetPath, inputSha256: hash(mutated), message: 'Syntax error' };
+
+for (const [name, overrides, outcome, disposition, kinds] of [
+  ['survivor', {}, 'passed', 'survived', []],
+  ['assertion body', { events: [body], exitCode: 1 }, 'assertions-failed', 'assertion-killed', ['assertions']],
+  ['structured transform', { events: [compile], exitCode: 1 }, 'compile-failed', 'compile-failed', ['compile']],
+  ['missing dependency', { events: [{ origin: 'import', message: 'Module not found' }], exitCode: 1 }, 'setup-failed', 'setup-failed', ['setup']],
+  ['hook AssertionError', { events: [{ origin: 'hook', message: 'AssertionError' }], exitCode: 1 }, 'setup-failed', 'setup-failed', ['setup']],
+  ['unknown origin compile text', { events: [{ origin: 'unknown', message: 'SyntaxError compile' }], exitCode: 1 }, 'setup-failed', 'setup-failed', ['setup']],
+  ['timeout', { timedOut: true, exitCode: null }, 'timed-out', 'timed-out', ['timeout']],
+  ['broker refusal', { events: [{ origin: 'broker', message: 'source path escape' }], exitCode: null }, 'refused', 'refused', ['refusal']],
+] as const) {
+  test(`T08 ${name} retains its structured origin`, () => {
+    const result = classifyQualityRun(facts(structuredClone(overrides) as any));
+    assert.equal(result.outcome, outcome);
+    assert.equal(result.mutationDisposition, disposition);
+    assert.deepEqual([...result.failureKinds].sort(), [...kinds].sort());
+    assert.deepEqual(result.knownRed, name === 'assertion body' ? [testId] : []);
+    if (outcome === 'compile-failed') assert.equal(result.nextAction, 'fix-setup');
+  });
+}
+
+test('T08 compile provenance can prove transform input without claiming successful load', () => {
+  const input = facts({ events: [compile], exitCode: 1 });
+  input.loadedSources[0].loaded = false; input.loadedSources[0].stage = 'transform';
+  const result = classifyQualityRun(input);
+  assert.equal(result.mutationDisposition, 'compile-failed');
+  assert.notEqual(result.mutationDisposition, 'assertion-killed');
+});
+
+for (const [name, overrides] of [
+  ['failed baseline', { baselineGreen: false }],
+  ['no sites', { siteCount: 0 }],
+  ['no loaded target', { loadedSources: [] }],
+  ['incomplete protocol', { protocolComplete: false }],
+  ['incomplete cleanup', { cleanup: { complete: false, remainingPids: [123] } }],
+  ['interruption', { interrupted: true }],
+] as const) {
+  test(`T09/T12 ${name} is unverified even if upstream says killed`, () => {
+    const result = classifyQualityRun(facts({ ...structuredClone(overrides), events: [body], exitCode: 1, rawUpstreamOutcome: 'killed' } as any));
+    assert.equal(result.mutationDisposition, 'unverified');
+    assert.ok(result.reason);
+    assert.equal(result.rawUpstreamOutcome, 'killed');
+    assert.notEqual(result.outcome, 'passed');
+  });
+}
+
+for (const field of ['runId', 'inputSha256', 'path'] as const) {
+  test(`T12 target load ${field} mismatch cannot prove kill or survivor`, () => {
+    for (const events of [[], [body]]) {
+      const input = facts({ events, exitCode: events.length ? 1 : 0 }); input.loadedSources[0][field] = 'foreign';
+      const result = classifyQualityRun(input);
+      assert.equal(result.mutationDisposition, 'unverified');
+      assert.ok(result.reason);
+    }
+  });
+}
+
+test('T09 mixed assertion, compile, setup and timeout retain every fact', () => {
+  const result = classifyQualityRun(facts({ events: [body, compile, { origin: 'hook', message: 'setup' }], timedOut: true, exitCode: null }));
+  assert.equal(result.outcome, 'timed-out');
+  assert.equal(result.mutationDisposition, 'timed-out');
+  assert.deepEqual([...result.failureKinds].sort(), ['assertions', 'compile', 'setup', 'timeout']);
+  assert.deepEqual(result.knownRed, [testId]);
+});
+
+test('T09 setup takes priority over compile which takes priority over assertions', () => {
+  const input = facts({ events: [body, compile], exitCode: 1 });
+  assert.equal(classifyQualityRun(input).outcome, 'compile-failed');
+  input.events.push({ origin: 'hook', message: 'hook failure' });
+  const result = classifyQualityRun(input);
+  assert.equal(result.outcome, 'setup-failed');
+  assert.deepEqual(result.knownRed, [testId]);
+});
+
+test('T09 runner protocol accepts structured transform stage without parsing stderr', () => {
+  const protocol = new RunnerProtocol();
+  const event = { kind: 'compile-failed', stage: 'transform', path: targetPath, inputSha256: hash(mutated), diagnostic: 'Syntax error' };
+  assert.deepEqual(protocol.accept(event), event);
+  assert.throws(() => new RunnerProtocol().accept({ kind: 'compile-failed', diagnostic: 'compile' }));
+});
+
+test('T09 compile result passes sandbox formatter with quality evidence intact', async () => {
+  const h = new RunHarness();
+  const result = await runTestRun(fixtureRequest(), h.config, policy, h.context, h.ports);
+  const quality = { mode: 'mutant', baselineRunId: 'baseline-1', mutationDisposition: 'compile-failed', loadedSources: facts().loadedSources };
+  const reply = { code: 1, stderr: '', stdout: JSON.stringify({ ...result, outcome: 'compile-failed', failureKinds: ['compile'], quality }) };
+  const text = formatSandboxTestRunEvidence({ command: 'raf test run', workspace: h.context.workspace, sha: 'fixture', dirtyPaths: [], artifact: '/fixture/evidence.json', reply });
+  assert.doesNotMatch(text, /missing, malformed or truncated/);
+  assert.match(text, /compile-failed/);
+  assert.match(text, /mutant-1/);
+  assert.match(text, new RegExp(hash(mutated)));
+});
+
+
+test('T08 production runner classifier distinguishes compile from assertions and preserves IDs', () => {
+  const events = [
+    { kind: 'assertion-failed', test: testId },
+    { kind: 'compile-failed', stage: 'transform', path: targetPath, inputSha256: hash(mutated), diagnostic: 'invalid token' },
+    { kind: 'complete', expected: [testId] },
+  ];
+  const result = classifyRunnerResult(events as any, { exitCode: 1, signal: null, stderr: 'arbitrary text' });
+  assert.equal(result.outcome, 'compile-failed');
+  assert.deepEqual([...result.failureKinds].sort(), ['assertions', 'compile']);
+  assert.deepEqual(result.knownRed, [testId]);
+});
diff --git a/test/quality-overlay-transport.test.ts b/test/quality-overlay-transport.test.ts
new file mode 100644
index 0000000..0da68c9
--- /dev/null
+++ b/test/quality-overlay-transport.test.ts
@@ -0,0 +1,114 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { parseTestRunArgs, planTestRun } from '../src/test-runs.ts';
+import { parseQualityRequest, prepareQualityExecution, recoverQualityCopies } from '../src/test-run-quality.ts';
+import { fixtureConfig, fixtureContext, fixtureEnvironment, fixtureRequest } from './helpers/test-run-fixture.ts';
+import { context, hash, mutated, mutation, request, selected, source, targetPath, transport, workspace } from './helpers/quality-fixture.ts';
+
+const refused = (error: unknown) => error instanceof Error && error.message !== 'NotImplemented' && /path|escape|hash|before|baseline|snapshot|selector|function|source|control|field|mode|version|selection|config|dependency|owner|changed/i.test(error.message);
+
+test('T01 ordinary planning keeps canonical routing, selection and isolated HOME', () => {
+  const config = fixtureConfig(), ctx = fixtureContext();
+  const plan = planTestRun(fixtureRequest(), config, ctx, fixtureEnvironment());
+  assert.equal(plan.command.cwd, ctx.workspace);
+  assert.equal(plan.command.environment.HOME, ctx.home);
+  assert.deepEqual(plan.selection.files, fixtureRequest().files);
+  assert.ok(!('executionRoot' in plan));
+});
+
+test('T01 quality-request is one data argument and does not replace exact test selection', () => {
+  const argv = ['--project', 'raf', '--phase', 'red', '--group', 'adopt-ub-mode-quality-gates/quality-transport', '--files', 'test/a.test.ts', '--quality-request', '/private/request.json'];
+  assert.deepEqual(parseTestRunArgs(argv), { project: 'raf', phase: 'red', group: argv[5], files: ['test/a.test.ts'], qualityRequest: '/private/request.json' });
+  assert.throws(() => parseTestRunArgs([...argv, '--quality-request', '/other.json']));
+});
+
+test('T02 descriptor baseline and mutant preserve byte spans without caller execution options', () => {
+  assert.deepEqual(parseQualityRequest(request()), request());
+  assert.deepEqual(parseQualityRequest(request('baseline')), request('baseline'));
+});
+
+for (const [name, change] of [
+  ['escape', (r: any) => { r.mutant.path = '../outside.ts'; }],
+  ['option path', (r: any) => { r.source.files[0].path = '--import'; }],
+  ['cwd', (r: any) => { r.cwd = '/other'; }],
+  ['env', (r: any) => { r.env = { HOME: '/operational' }; }],
+  ['argv', (r: any) => { r.argv = ['untrusted']; }],
+  ['baseline with mutant', (r: any) => { r.mode = 'baseline'; }],
+] as const) {
+  test(`T04 rejects descriptor ${name} as data before any execution`, () => {
+    const value = request(); change(value);
+    assert.throws(() => parseQualityRequest(value), refused);
+  });
+}
+
+test('T02 host snapshot patches only selected bytes in a private copy', async () => {
+  const f = transport(), before = structuredClone(f.snapshot);
+  const plan = await prepareQualityExecution(request(), context(), f.ports);
+  assert.equal(plan.canonicalWorkspace, workspace);
+  assert.equal(plan.executionRoot, '/fixture/private/run-1');
+  assert.equal(plan.cwd, plan.executionRoot);
+  assert.equal(plan.sourceSnapshotDigest, f.snapshot.digest);
+  assert.notEqual(plan.executionSnapshotDigest, plan.sourceSnapshotDigest);
+  assert.equal(Buffer.from(plan.inputs.find(input => input.path === targetPath)!.bytes).toString(), mutated);
+  assert.deepEqual(plan.selection, context().selection);
+  assert.deepEqual(f.snapshot, before);
+  assert.deepEqual(plan.selectedSites, [mutation]);
+  assert.deepEqual(f.calls.selected, [selected.id]);
+});
+
+for (const [name, change] of [
+  ['source hash', (r: any) => { r.source.files[0].sha256 = hash('wrong'); }],
+  ['before bytes', (r: any) => { r.mutant.beforeBase64 = Buffer.from('99').toString('base64'); }],
+  ['neighbor on same line', (r: any) => { r.mutant.startByte = source.indexOf('7'); r.mutant.endByte = source.indexOf('7') + 1; r.mutant.beforeBase64 = Buffer.from('7').toString('base64'); }],
+  ['spoofed function ID', (r: any) => { r.mutant.functionId = 'neighbor'; }],
+  ['test replacement', (r: any) => { r.mutant.path = 'test/answer.test.ts'; }],
+  ['config replacement', (r: any) => { r.mutant.path = 'runner.config.ts'; }],
+] as const) {
+  test(`T04/T05/T06 rejects ${name} before making an execution copy`, async () => {
+    const f = transport(), value = request(); change(value);
+    await assert.rejects(prepareQualityExecution(value, context(), f.ports), refused);
+    assert.equal(f.calls.copies, 0);
+    assert.equal(Buffer.from(f.snapshot.inputs[0].bytes).toString(), source);
+  });
+}
+
+for (const field of ['sourceSnapshotDigest', 'selectionDigest', 'configDigest', 'dependencyDigest', 'owner'] as const) {
+  test(`T05 mutant refuses baseline ${field} mismatch`, async () => {
+    const f = transport(); f.saved[field] = 'different';
+    await assert.rejects(prepareQualityExecution(request(), context(), f.ports), refused);
+    assert.equal(f.calls.copies, 0);
+  });
+}
+
+test('T04 caller cannot supply a foreign baseline artifact as trusted evidence', async () => {
+  const f = transport(), value = request(); value.baselineRunId = '/foreign/baseline.json';
+  await assert.rejects(prepareQualityExecution(value, context(), f.ports), refused);
+  assert.equal(f.calls.copies, 0);
+});
+
+test('T04 symlink escape is refused before scheduling', async () => {
+  const f = transport(); f.snapshot.inputs[0].realpath = '/foreign/answer.ts';
+  await assert.rejects(prepareQualityExecution(request(), context(), f.ports), refused);
+  assert.equal(f.calls.copies, 0);
+});
+
+test('T05 input changed while sealing cannot certify the requested source', async () => {
+  const f = transport(); f.ports.readCurrent = async () => Buffer.from('changed during snapshot');
+  await assert.rejects(prepareQualityExecution(request(), context(), f.ports), refused);
+  assert.equal(f.calls.copies, 0);
+});
+
+test('T06 unsupported function selector leaves same-line neighbors unscheduled', async () => {
+  const f = transport(); f.ports.selectSites = async () => ({ supported: false, reason: 'ambiguous overload', sites: [] });
+  await assert.rejects(prepareQualityExecution(request(), context(), f.ports), refused);
+  assert.equal(f.calls.copies, 0);
+});
+
+test('T11 recovery removes only owned terminated copies', async () => {
+  const f = transport();
+  const copies = ['terminated', 'active', 'unknown'].map(tree => ({ root: `/private/${tree}`, owner: context().owner, runId: tree, tree: tree as 'terminated' | 'active' | 'unknown' }));
+  copies.push({ root: '/private/foreign', owner: 'another-wrapper', runId: 'foreign', tree: 'terminated' });
+  const removed = await recoverQualityCopies(copies, context().owner, f.ports);
+  assert.deepEqual(removed, ['/private/terminated']);
+  assert.deepEqual(f.calls.removed, removed);
+});
diff --git a/test/quality-transport-runtime.integration.test.ts b/test/quality-transport-runtime.integration.test.ts
new file mode 100644
index 0000000..9294715
--- /dev/null
+++ b/test/quality-transport-runtime.integration.test.ts
@@ -0,0 +1,155 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { execFileSync } from 'node:child_process';
+import { mkdir, mkdtemp, readFile, readdir, rm, stat, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { runTestRunCli } from '../src/test-run-cli.ts';
+import { createTestRunPorts } from '../src/test-run-runtime.ts';
+import { openStateStore } from '../src/state-store.ts';
+import type { StateContext } from '../src/state-migration-guard.ts';
+import { fixtureConfig, fixtureContext, policy } from './helpers/test-run-fixture.ts';
+import { hash } from './helpers/quality-fixture.ts';
+import type { QualityRequest } from '../src/test-run-quality.ts';
+
+const codeRoot = fileURLToPath(new URL('..', import.meta.url));
+const change = 'adopt-ub-mode-quality-gates';
+const group = `${change}/quality-transport-runtime`;
+
+async function stand(t: import('node:test').TestContext, route: 'relative' | 'alias' | 'dynamic') {
+  const root = await mkdtemp(join(tmpdir(), 'raf-quality-'));
+  const workspace = join(root, 'workspace'), home = join(root, 'qa'), operational = join(root, 'operational');
+  for (const path of [workspace, home, operational, join(workspace, 'src'), join(workspace, 'test'), join(root, 'runs')]) await mkdir(path, { recursive: true, mode: 0o700 });
+  const source = 'export function answer() { return 42; }\n';
+  await writeFile(join(workspace, 'src/answer.ts'), source);
+  await writeFile(join(workspace, 'package.json'), JSON.stringify({ type: 'module', imports: { '#answer': './src/answer.ts' } }));
+  const importer = route === 'relative' ? "import { answer } from '../src/answer.ts';" : route === 'alias' ? "import { answer } from '#answer';" : "const { answer } = await import('../src/answer.ts');";
+  await writeFile(join(workspace, 'test/answer.test.ts'), `import assert from 'node:assert/strict'; import test from 'node:test'; ${importer}\ntest('required answer', () => assert.equal(answer(), 42));\n`);
+  await writeFile(join(operational, 'state.sqlite'), 'operational sentinel');
+  const git = (...args: string[]) => execFileSync('git', ['-C', workspace, ...args], { encoding: 'utf8' }).trim();
+  git('init', '-q'); git('add', '--', 'src/answer.ts', 'test/answer.test.ts', 'package.json');
+  git('-c', 'user.name=Quality Stand', '-c', 'user.email=quality@invalid', '-c', 'core.hooksPath=/dev/null', 'commit', '-qm', 'quality stand');
+  const revision = git('rev-parse', 'HEAD');
+  const config = fixtureConfig();
+  config.temporaryArtifacts = { root: join(root, 'runs'), minimumNestedSocketPathBytes: 1 };
+  config.projects = { raf: { profiles: { node: {
+    cwd: '.', executable: process.execPath, argv: [join(codeRoot, 'scripts/test-run-node.ts')], unitFiles: ['test/answer.test.ts'], exactIds: 'node-test-name', resultAdapter: 'node-test-events', environment: { isolatedHome: true, stateOrigin: true }, checks: [],
+    quality: { sourceAdapter: { id: 'node-source', version: process.version }, siteSelector: { id: 'typescript-function', version: '1' }, coverage: { producer: 'node-v8', version: process.version, adapter: 'v8', argv: [], format: 'v8' } },
+  } as any }, groups: { [group]: { profileId: 'node', files: ['test/answer.test.ts'] } } } };
+  const context = { ...fixtureContext(), cwd: workspace, workspace, projectWorkspaces: { raf: [workspace] }, activeChanges: [change], sha: revision, home, statePath: join(home, '.raf/state.sqlite'), tmpPath: join(home, '.raf/tmp'), operationalHome: operational };
+  const stateContext: StateContext = { mode: 'qa', orchestratorRoot: root, codeRoot, homeDirectory: home, statePath: context.statePath, tmpRoot: context.tmpPath, tmuxSocketPath: join(home, '.raf/tmux/server.sock') };
+  const store = openStateStore(context.statePath, { context: stateContext });
+  t.after(async () => { store.close(); await rm(root, { recursive: true, force: true }); });
+  const request: QualityRequest = { version: 1, mode: 'baseline', source: { baseRevision: revision, revision, files: [{ path: 'src/answer.ts', sha256: hash(source) }] }, changedFunctions: [{ id: 'src/answer.ts/answer/0', path: 'src/answer.ts', startByte: 0, endByte: Buffer.byteLength(source) }] };
+  const baselinePath = join(root, 'baseline.json'); await writeFile(baselinePath, JSON.stringify(request));
+  const configurationBytes = { flow: Buffer.from(JSON.stringify({ unitTests: policy })), projects: Buffer.from(JSON.stringify({ projects: { raf: { path: workspace } } })), testRuns: Buffer.from(JSON.stringify(config)) };
+  const invoke = async (path: string, failure?: 'spawn' | 'interruption') => {
+    let stdout = '', stderr = '';
+    const args = ['--project', 'raf', '--phase', 'qa', '--group', group, '--quality-request', path];
+    const runtime = createTestRunPorts(config, stateContext, () => store, { PATH: process.env.PATH }, configurationBytes, { project: 'raf', phase: 'qa', group });
+    if (failure === 'spawn') runtime.spawn = async () => { throw Object.assign(new Error('fixture spawn unavailable'), { code: 'ENOENT' }); };
+    if (failure === 'interruption') {
+      let interrupt: ((signal: string) => void) | undefined;
+      const subscribe = runtime.subscribeInterruption, spawn = runtime.spawn;
+      runtime.subscribeInterruption = callback => { interrupt = callback; return subscribe(callback); };
+      runtime.spawn = async (...args) => { const child = await spawn(...args); queueMicrotask(() => interrupt!('SIGTERM')); return child; };
+    }
+    const code = await runTestRunCli(args, { config, policy, context, runtime, stdout: text => { stdout += text; }, stderr: text => { stderr += text; } });
+    assert.ok(stdout.trim(), stderr);
+    return { code, stderr, result: JSON.parse(stdout) };
+  };
+  const mutant = async (baselineRunId: string, after = '41') => {
+    const offset = source.indexOf('42');
+    const value: QualityRequest = { ...request, mode: 'mutant', baselineRunId, mutant: { siteId: 'answer/42', functionId: request.changedFunctions[0].id, path: 'src/answer.ts', startByte: offset, endByte: offset + 2, beforeBase64: Buffer.from('42').toString('base64'), afterBase64: Buffer.from(after).toString('base64') } };
+    const path = join(root, `mutant-${hash(after)}.json`); await writeFile(path, JSON.stringify(value));
+    return invoke(path);
+  };
+  return { root, workspace, operational, source, baselinePath, invoke, mutant };
+}
+
+for (const route of ['relative', 'alias', 'dynamic'] as const) {
+  test(`T02/T03/T07/T11 actual ${route} load executes private mutant through test run CLI`, async t => {
+    const f = await stand(t, route);
+    const canonical = join(f.workspace, 'src/answer.ts');
+    const before = await readFile(canonical);
+    const base = await f.invoke(f.baselinePath);
+    assert.equal(base.code, 0, JSON.stringify(base));
+    assert.equal(base.result.outcome, 'passed');
+    assert.equal(base.result.quality.mode, 'baseline');
+    const coverage = base.result.quality.coverage;
+    assert.equal(coverage.runId, base.result.runId);
+    assert.equal(coverage.producer.complete, true);
+    assert.equal(coverage.producer.exitCode, 0);
+    assert.equal(coverage.artifact.sha256, hash(await readFile(coverage.artifact.path)));
+    assert.equal(coverage.sourceSnapshotDigest, base.result.quality.sourceSnapshotDigest);
+    const mutant = await f.mutant(base.result.runId);
+    assert.notEqual(mutant.code, 0);
+    assert.equal(mutant.result.outcome, 'assertions-failed');
+    assert.equal(mutant.result.quality.mutationDisposition, 'assertion-killed');
+    assert.deepEqual(mutant.result.knownRed, [{ file: 'test/answer.test.ts', name: 'required answer' }]);
+    const load = mutant.result.quality.loadedSources.find((entry: any) => entry.path === 'src/answer.ts');
+    assert.ok(load?.loaded);
+    assert.equal(load.runId, mutant.result.runId);
+    assert.equal(load.inputSha256, hash(f.source.replace('42', '41')));
+    assert.notEqual(load.resolvedPath, canonical);
+    assert.notEqual(mutant.result.quality.executionSnapshotDigest, base.result.quality.executionSnapshotDigest);
+    assert.equal(mutant.result.quality.sourceSnapshotDigest, base.result.quality.sourceSnapshotDigest);
+    assert.deepEqual(await readFile(canonical), before);
+    assert.equal(await readFile(join(f.operational, 'state.sqlite'), 'utf8'), 'operational sentinel');
+    assert.equal(mutant.result.cleanup.complete, true);
+    assert.deepEqual(mutant.result.cleanup.remainingPids, []);
+    await assert.rejects(stat(dirname(load.resolvedPath)), { code: 'ENOENT' });
+    const repeated = await f.invoke(f.baselinePath);
+    assert.equal(repeated.code, 0);
+    assert.deepEqual(repeated.result.knownRed, []);
+    assert.deepEqual(await readFile(canonical), before);
+  });
+}
+
+test('T08 real invalid mutant is compile-failed, never behavioral kill', async t => {
+  const f = await stand(t, 'relative');
+  const base = await f.invoke(f.baselinePath); assert.equal(base.code, 0, JSON.stringify(base));
+  const invalid = await f.mutant(base.result.runId, ')');
+  assert.notEqual(invalid.code, 0);
+  assert.equal(invalid.result.outcome, 'compile-failed');
+  assert.equal(invalid.result.quality.mutationDisposition, 'compile-failed');
+  assert.ok(invalid.result.failureKinds.includes('compile'));
+  assert.deepEqual(invalid.result.knownRed, []);
+  assert.ok(invalid.result.quality.loadedSources.some((entry: any) => entry.stage === 'transform' && entry.loaded === false));
+  assert.equal(await readFile(join(f.workspace, 'src/answer.ts'), 'utf8'), f.source);
+  assert.equal(invalid.result.cleanup.complete, true);
+});
+
+test('T05 changing dirty test bytes invalidates previously green baseline', async t => {
+  const f = await stand(t, 'relative');
+  const base = await f.invoke(f.baselinePath); assert.equal(base.code, 0, JSON.stringify(base));
+  await writeFile(join(f.workspace, 'test/answer.test.ts'), "throw new Error('changed test inputs');\n");
+  const result = await f.mutant(base.result.runId);
+  assert.notEqual(result.code, 0);
+  assert.notEqual(result.result.quality.mutationDisposition, 'assertion-killed');
+  assert.notEqual(result.result.quality.mutationDisposition, 'survived');
+  assert.match(JSON.stringify(result.result), /baseline|snapshot|input/i);
+  assert.equal(await readFile(join(f.workspace, 'src/answer.ts'), 'utf8'), f.source);
+  assert.deepEqual(result.result.cleanup.remainingPids, []);
+});
+
+
+for (const failure of ['spawn', 'interruption'] as const) {
+  test(`T11 actual private run ${failure} preserves canonical and foreign artifacts`, async t => {
+    const f = await stand(t, 'relative');
+    const canonical = join(f.workspace, 'src/answer.ts');
+    const before = await readFile(canonical);
+    const foreign = join(f.root, 'foreign-tmp'); await mkdir(foreign); await writeFile(join(foreign, 'keep'), 'another owner');
+    const result = await f.invoke(f.baselinePath, failure);
+    assert.notEqual(result.code, 0);
+    assert.equal(result.result.outcome, failure === 'spawn' ? 'setup-failed' : 'interrupted');
+    assert.notEqual(result.result.quality.mutationDisposition, 'assertion-killed');
+    assert.equal(result.result.cleanup.complete, true);
+    assert.deepEqual(result.result.cleanup.remainingPids, []);
+    assert.deepEqual(await readFile(canonical), before);
+    assert.equal(await readFile(join(foreign, 'keep'), 'utf8'), 'another owner');
+    assert.equal(await readFile(join(f.operational, 'state.sqlite'), 'utf8'), 'operational sentinel');
+    assert.deepEqual(await readdir(join(f.root, 'runs')), []);
+  });
+}
