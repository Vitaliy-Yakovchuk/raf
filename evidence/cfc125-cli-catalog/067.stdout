{
  "program": "raf",
  "commands": [
    {
      "path": [
        "bug",
        "list"
      ],
      "description": "Переглянути локальні жуки з фільтрами.",
      "parameters": [
        {
          "name": "project",
          "option": "--project",
          "required": false,
          "multiple": false,
          "description": "Канонічний проєкт, наприклад projects/etchly.",
          "type": "string",
          "requirement": "optional"
        },
        {
          "name": "status",
          "option": "--status",
          "required": false,
          "multiple": false,
          "description": "Фільтр за статусом серверного контракту.",
          "type": "string",
          "requirement": "optional"
        },
        {
          "name": "cursor",
          "option": "--cursor",
          "required": false,
          "multiple": false,
          "description": "Позиція наступної сторінки.",
          "type": "string",
          "requirement": "optional"
        },
        {
          "name": "limit",
          "option": "--limit",
          "required": false,
          "multiple": false,
          "description": "Розмір сторінки в межах конфігурації.",
          "type": "string",
          "requirement": "optional"
        }
      ],
      "output": "JSON зі сторінкою жуків, continuation cursor та станом синхронізації.",
      "errors": "Ненульовий код та стисла достатня діагностика за cli-catalog.",
      "prerequisites": "База жуків; служба raf не потрібна (background-runtime «Межі служби raf»); авторизація чинного bugs-api для мережевих дій. До реалізації команда має явно повідомляти недоступність.",
      "sideEffects": "Читання локальної бази; фонову синхронізацію виконує служба.",
      "examples": [
        "raf bug list"
      ],
      "errorCodes": [
        {
          "id": "UNKNOWN_COMMAND",
          "description": "Невідомий шлях команди або довідки.",
