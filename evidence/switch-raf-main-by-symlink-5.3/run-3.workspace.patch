 export async function advanceMainHandover(
   context: HandoverContext,
   transitionId: string,
 ): Promise<HandoverProgress> {
-  throw new Error('NotImplemented');
+  return serial(handoverTails, context, () => advanceHandover(context, transitionId));
+}
+
+async function advanceHandover(context: HandoverContext, transitionId: string): Promise<HandoverProgress> {
+  const state = await context.store.read();
+  const transition = state.transition;
+  if (!transition || transition.id !== transitionId) fail('MAIN_HANDOVER_MISSING', 'Unknown main handover transition');
+  if (transition.status === 'blocked') return { status: 'blocked', reason: 'Main handover is blocked' };
+  if (transition.status === 'waiting') {
+    if (state.activeGeneration !== transition.to) return { status: 'blocked', reason: 'Main publication changed during handover' };
+    assertCompatible(state, transition.from, transition.to);
+    for (const role of roles) {
+      if (!await ownerReady(context, state.owners[transition.newOwners[role]])) return { status: 'waiting', reason: 'New main owner readiness is not restored: ' + role };
+    }
+    const transferred = await context.store.transaction(current => {
+      if (current.transition?.id !== transition.id) fail('MAIN_HANDOVER_STALE', 'Main handover changed during readiness');
+      if (current.transition.status === 'complete') return true;
+      if (current.transition.status !== 'waiting' || current.activeGeneration !== transition.to) return false;
+      assertCompatible(current, transition.from, transition.to);
+      if (Object.values(current.operations).some(operation => operation.generation === transition.from)) return false;
+      for (const role of roles) {
+        if (current.transition.newOwners[role] !== transition.newOwners[role]) return false;
+        if (![transition.oldOwners[role], transition.newOwners[role]].includes(current.activeOwners[role])) fail('OWNER_FENCED', 'Main ownership changed during handover');
+      }
+      for (const role of roles) {
+        const previous = current.owners[transition.oldOwners[role]];
+        previous.phase = 'retired';
+        const owner = current.owners[transition.newOwners[role]];
+        owner.phase = 'active';
+        current.activeOwners[role] = owner.ownerId;
+      }
+      return true;
+    });
+    if (!transferred) return { status: 'waiting', reason: 'Old main pinned operations must drain' };
+  }
+  if (!await retireOwners(context)) return { status: 'waiting', reason: 'Old main readers must drain' };
+  const current = await context.store.read();
+  for (const role of ['worker', 'notice'] as const) await drainMainFacts(context, current.owners[current.activeOwners[role]]);
+  return context.store.transaction(latest => {
+    if (latest.transition?.id !== transition.id || roles.some(role => latest.activeOwners[role] !== latest.transition?.newOwners[role])) return { status: 'waiting', reason: 'Main ownership changed before completion' };
+    latest.transition.status = 'complete';
+    return { status: 'complete' };
+  });
 }
 
 export async function recoverMainHandover(
   context: HandoverContext,
 ): Promise<HandoverProgress> {
-  throw new Error('NotImplemented');
