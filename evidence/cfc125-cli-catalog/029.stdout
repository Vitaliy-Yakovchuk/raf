      "handlerName": "reminder add",
      "metadata": {
        "path": [
          "reminder",
          "add"
        ],
        "valueSources": {
          "event": "raf-constants.json#/events",
          "event-action": "raf-constants.json#/reminderBindingActions"
        },
        "description": "Створити нагадування з обов’язковим адресатом і часом.",
        "parameters": [
          {
            "name": "to",
            "option": "--to",
            "required": true,
            "multiple": false,
            "description": "Адресний ID активної сесії з raf agent ps, включно з main; стає первинним і поточним адресатом."
          },
          {
            "name": "at",
            "option": "--at",
            "required": true,
            "multiple": false,
            "description": "Обов’язковий час активації ISO 8601 з явним зсувом або Z; обов’язковий і для подієвої прив’язки."
          },
          {
            "name": "text",
            "option": "--text",
            "required": true,
            "multiple": false,
            "description": "Непорожній зміст нагадування."
          },
          {
            "name": "event",
            "option": "--event",
            "required": false,
            "multiple": false,
            "description": "Тип події з events; задається разом з --event-id та --event-action або не задається жоден із трьох."
          },
          {
            "name": "event-id",
            "option": "--event-id",
            "required": false,
            "multiple": false,
            "description": "ID об’єкта події, сумісний з idKind обраного типу за eventIdKinds."
          },
          {
            "name": "event-action",
            "option": "--event-action",
            "required": false,
            "multiple": false,
            "description": "Дія прив’язки з reminderBindingActions: activate або close."
          }
        ],
        "output": "JSON створеного нагадування; exit 0 після збереження.",
        "errors": "Ненульовий код і JSON із причиною, деталями та кроком виправлення за cli-catalog; коди перелічено в add-raf-reminders/design.md «Параметри команд».",
        "prerequisites": "Адресат --to активний; --at — ISO 8601 із Z/зсувом. --event, --event-id та --event-action задаються всі разом або відсутні.",
        "sideEffects": "Створює нагадування й застосовну прив’язку події в SQLite; зберігає первинного адресата.",
        "examples": [
          "raf reminder add --to main --at 2026-10-22T18:00:00+03:00 --text \"Перевірити викладку\"",
          "raf reminder add --to hotfix-demo --at 2026-10-23T09:00:00Z --text \"Архівувати зміну\" --event openspec.archived --event-id add-raf-reminders --event-action close"
        ],
        "errorCodes": [
