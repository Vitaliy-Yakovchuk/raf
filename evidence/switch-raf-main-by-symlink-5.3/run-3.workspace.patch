+      const owner = state.owners[operation.ownerId];
+      if (owner && !await context.runtime.isAlive(owner)) await context.store.transaction(current => {
+        const held = current.operations[operation.id];
+        if (held?.ownerId === owner.ownerId && held.factId === operation.factId) delete current.operations[operation.id];
+      });
+    }
+    if (state.transition?.status === 'blocked') return { status: 'blocked', reason: 'Main handover is blocked' };
