{
  "program": "raf",
  "commands": [
    {
      "path": [
        "resource",
        "wait"
      ],
      "description": "Очікувати ресурсного допуску через чергу служби raf; код 0 означає наданий дозвіл.",
      "requiresService": true,
      "recordDuration": false,
      "parameters": [
        {
          "name": "level",
          "option": "--level",
          "required": true,
          "description": "Рівень ресурсного допуску, якого потрібно дочекатися.",
          "type": "string",
          "multiple": false,
          "values": [
            {
              "id": "CFC125_QA_ONLY",
              "description": "Допуск за CFC125_QA_ONLY-порогами resource-admission",
              "priority": 0
            },
            {
              "id": "normal",
              "description": "Допуск за звичайними порогами resource-admission",
              "priority": 1
            }
          ],
          "requirement": "required"
        }
      ],
      "valueSources": {
