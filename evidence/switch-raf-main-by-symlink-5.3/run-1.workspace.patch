+function generation(state: HandoverState, id: GenerationId): MainGeneration {
+  const value = state.generations[id];
+  if (!value || !value.published) fail('MAIN_GENERATION_UNPUBLISHED', 'Unknown or unpublished main generation: ' + id);
+  return value;
+}
+
+function assertCompatible(state: HandoverState, from: GenerationId, to: GenerationId): void {
+  const previous = generation(state, from);
+  const next = generation(state, to);
+  for (const kind of protocols) {
+    const left = previous.protocols[kind];
+    const right = next.protocols[kind];
+    if (!left || !right || !left.accepts.includes(right.emits) || !right.accepts.includes(left.emits)) {
+      fail('MAIN_PROTOCOL_INCOMPATIBLE', 'Incompatible bidirectional main protocol: ' + kind);
+    }
+  }
+  for (const { fact, status } of Object.values(state.facts)) {
+    if (status === 'pending' && !next.protocols[fact.kind].accepts.includes(fact.protocol)) {
