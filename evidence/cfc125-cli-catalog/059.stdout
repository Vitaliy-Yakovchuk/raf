{
  "program": "raf",
  "commands": [
    {
      "path": [
        "bug",
        "attachment",
        "get"
      ],
      "description": "Отримати доступ до вкладення жука або коментаря з лінивим кешуванням.",
      "parameters": [
        {
          "name": "bug",
          "option": "--bug",
          "required": true,
          "multiple": false,
          "description": "Повний канонічний ключ жука.",
          "type": "string",
          "requirement": "required"
        },
        {
          "name": "attachment",
          "option": "--attachment",
          "required": true,
          "multiple": false,
          "description": "Серверний ID вкладення з метаданих жука або коментаря.",
          "type": "string",
          "requirement": "required"
        }
      ],
      "output": "JSON з доступним локальним шляхом і метаданими вкладення; помилка не повертає удаваного шляху.",
      "errors": "Ненульовий код та стисла достатня діагностика за cli-catalog.",
      "prerequisites": "База жуків; служба raf не потрібна (background-runtime «Межі служби raf»); авторизація чинного bugs-api для мережевих дій. До реалізації команда має явно повідомляти недоступність.",
      "sideEffects": "Перевірка доступу, завантаження за відсутності валідного кешу, оновлення lastReadAt у базі жуків і застосування бюджету кешу.",
      "examples": [
        "raf bug attachment get --bug raf:1 --attachment attachment-id"
      ],
      "errorCodes": [
        {
          "id": "UNKNOWN_COMMAND",
          "description": "Невідомий шлях команди або довідки.",
          "exitCode": 1
        },
        {
          "id": "UNKNOWN_ARGUMENT",
          "description": "Невідомий аргумент або зайве позиційне значення.",
          "exitCode": 1
        },
        {
          "id": "DUPLICATE_ARGUMENT",
          "description": "Одиничний параметр передано повторно.",
          "exitCode": 1
        },
        {
